{
  "name": "influenca@root",
  "description": "tools for video production workflows",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://github.com/GaryB432/influenca#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaryB432/influenca.git"
  },
  "bugs": {
    "url": "https://github.com/GaryB432/influenca/issues"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter './apps/*' --filter './libraries/*' --if-present run build",
    "build:cli": "pnpm --filter @influenca/cli... --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format": "pnpm dlx prettier -wl .",
    "test": "pnpm -r --filter './apps/*' --filter './libraries/*' --if-present run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "pnpm -r --filter './apps/*' --filter './libraries/*' exec rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.3.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@types/cli-progress": "^3.11.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-svelte": "^3.12.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.38.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.1.5",
    "vitest": "catalog:"
  }
}
