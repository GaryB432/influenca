{
  "name": "@influenca/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "mv .env ~/tempenv && git clean -dfx && mv ~/tempenv .env",
    "build": "pnpm --recursive build",
    "dev:web": "pnpm --filter @influenca/web dev",
    "influenca": "node packages/cli/dist/bin.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-yaml": "^0.1.0",
    "globals": "^17.13.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
