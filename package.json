{
  "name": "influenca",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter './apps/*' run build",
    "typecheck": "tsc -b",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "pnpm -r --filter './apps/*' exec rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.3.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-svelte": "^3.12.2",
    "svelte": "^5.38.8",
    "tsdown": "^0.15.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}