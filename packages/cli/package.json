{
  "name": "@influenca/cli",
  "description": "command line for influenca project",
  "version": "0.1.0",
  "keywords": [
    "video",
    "media",
    "accession",
    "analysis"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
