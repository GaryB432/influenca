    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@optique/clack": "^1.3.3",
    "@optique/core": "^1.3.3",
    "@optique/run": "^1.3.3"
  },
  "devDependencies": {
    "@influenca/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaryB432/influenca.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/GaryB432/influenca#readme",
  "bugs": {
    "url": "https://github.com/GaryB432/influenca/issues"
